{
  "manifest_schema_version": 3,
  "sdk_version": "5.13.1",
  "app_id": "sendible-connector",
  "version": "0.1.0",
  "name": "Sendible",
  "description": "Sendible API v1 connector: manage social profiles, schedule messages, monitor social activities, and audit social account health.",
  "icon": "icon.svg",
  "actions_explicit": true,
  "system": false,
  "capabilities": [
    "sendible:manage"
  ],
  "tools": [
    {
      "name": "connect_sendible",
      "description": "Connect your Sendible account with an OAuth 2.0 access token.",
      "action_type": "write",
      "chain_callable": true,
      "effects": [
        "saves connection credentials"
      ],
      "parameters": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string",
            "default": "",
            "description": "Friendly connection label."
          },
          "access_token": {
            "type": "string",
            "description": "Sendible OAuth 2.0 Access Token."
          },
          "base_url": {
            "type": "string",
            "default": "https://api.sendible.com/api/v1",
            "description": "Sendible API base URL."
          }
        },
        "required": [
          "access_token"
        ]
      }
    },
    {
      "name": "list_connections",
      "description": "List connected Sendible accounts.",
      "action_type": "read",
      "chain_callable": true,
      "effects": [
        "reads connections list"
      ],
      "parameters": {
        "type": "object",
        "properties": {}
      }
    },
    {
      "name": "disconnect_sendible",
      "description": "Disconnect a Sendible account and remove stored credentials.",
      "action_type": "destructive",
      "chain_callable": false,
      "effects": [
        "removes stored credentials"
      ],
      "parameters": {
        "type": "object",
        "properties": {
          "connection_id": {
            "type": "string",
            "description": "Connection ID to remove."
          }
        },
        "required": [
          "connection_id"
        ]
      }
    },
    {
      "name": "list_profiles",
      "description": "List connected social profiles in Sendible.",
      "action_type": "read",
      "chain_callable": true,
      "effects": [
        "reads social profiles"
      ],
      "parameters": {
        "type": "object",
        "properties": {
          "connection_id": {
            "type": "string",
            "default": "",
            "description": "Optional connection ID."
          },
          "limit": {
            "type": "integer",
            "default": 20,
            "description": "Max profiles to return."
          }
        }
      }
    },
    {
      "name": "get_profile",
      "description": "Get details of a specific social profile.",
      "action_type": "read",
      "chain_callable": true,
      "effects": [
        "reads profile details"
      ],
      "parameters": {
        "type": "object",
        "properties": {
          "connection_id": {
            "type": "string",
            "default": "",
            "description": "Optional connection ID."
          },
          "profile_id": {
            "type": "string",
            "description": "Sendible profile ID."
          }
        },
        "required": [
          "profile_id"
        ]
      }
    },
    {
      "name": "list_messages",
      "description": "List messages and posts in Sendible.",
      "action_type": "read",
      "chain_callable": true,
      "effects": [
        "reads messages list"
      ],
      "parameters": {
        "type": "object",
        "properties": {
          "connection_id": {
            "type": "string",
            "default": "",
            "description": "Optional connection ID."
          },
          "status": {
            "type": "string",
            "default": "scheduled",
            "description": "Message status filter: scheduled, sent, drafts, undelivered."
          },
          "limit": {
            "type": "integer",
            "default": 20,
            "description": "Max messages to return."
          }
        }
      }
    },
    {
      "name": "create_message",
      "description": "Create and schedule a new social media message across selected profiles.",
      "action_type": "write",
      "chain_callable": true,
      "effects": [
        "creates and schedules social post"
      ],
      "parameters": {
        "type": "object",
        "properties": {
          "connection_id": {
            "type": "string",
            "default": "",
            "description": "Optional connection ID."
          },
          "profile_ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Target social profile IDs."
          },
          "content": {
            "type": "string",
            "description": "Post text/message content."
          },
          "scheduled_for": {
            "type": "string",
            "description": "ISO 8601 schedule timestamp or empty for instant post."
          },
          "media_url": {
            "type": "string",
            "description": "Optional image or video attachment URL."
          }
        },
        "required": [
          "profile_ids",
          "content"
        ]
      }
    },
    {
      "name": "delete_message",
      "description": "Permanently delete a scheduled or draft message.",
      "action_type": "destructive",
      "chain_callable": false,
      "effects": [
        "permanently deletes message"
      ],
      "parameters": {
        "type": "object",
        "properties": {
          "connection_id": {
            "type": "string",
            "default": "",
            "description": "Optional connection ID."
          },
          "message_id": {
            "type": "string",
            "description": "Sendible message ID to delete."
          }
        },
        "required": [
          "message_id"
        ]
      }
    },
    {
      "name": "list_activities",
      "description": "List incoming social activities, mentions and comments from the Sendible Priority Inbox.",
      "action_type": "read",
      "chain_callable": true,
      "effects": [
        "reads social inbox activities"
      ],
      "parameters": {
        "type": "object",
        "properties": {
          "connection_id": {
            "type": "string",
            "default": "",
            "description": "Optional connection ID."
          },
          "profile_id": {
            "type": "string",
            "default": "",
            "description": "Optional profile filter."
          },
          "limit": {
            "type": "integer",
            "default": 20,
            "description": "Max activity items."
          }
        }
      }
    },
    {
      "name": "audit_social_health",
      "description": "Audit health of connected Sendible social accounts and scheduled message queues.",
      "action_type": "read",
      "chain_callable": true,
      "effects": [
        "analyzes account and message health"
      ],
      "parameters": {
        "type": "object",
        "properties": {
          "connection_id": {
            "type": "string",
            "default": "",
            "description": "Optional connection ID."
          }
        }
      }
    }
  ],
  "signals": [],
  "schedules": [],
  "required_scopes": [],
  "icon_size_bytes": 545,
  "lifecycle": {
    "health_check": {
      "interval_sec": 60
    }
  },
  "panels": [
    {
      "panel_id": "sendible_sidebar",
      "slot": "left",
      "title": "",
      "tree": {},
      "icon": "",
      "refresh": "manual",
      "center_overlay": false
    },
    {
      "panel_id": "__sendible_settings",
      "slot": "center",
      "title": "",
      "tree": {},
      "icon": "",
      "refresh": "manual",
      "center_overlay": false
    }
  ],
  "pricing": {
    "model": "per_action",
    "currency": "tokens",
    "monthly_price": 0,
    "revenue_split_dev": 70,
    "free_tools": [
      "connect_convertkit",
      "list_connections",
      "disconnect_convertkit"
    ],
    "tool_prices": {
      "connect_convertkit": 0,
      "list_connections": 0,
      "disconnect_convertkit": 0,
      "list_subscribers": 8,
      "get_subscriber": 8,
      "create_subscriber": 16,
      "update_subscriber": 16,
      "delete_subscriber": 16,
      "list_campaigns": 8,
      "get_campaign": 8,
      "create_campaign": 16,
      "update_campaign": 16,
      "delete_campaign": 16,
      "list_lists": 8,
      "get_list": 8,
      "create_list": 16,
      "update_list": 16,
      "delete_list": 16,
      "list_segments": 8,
      "get_segment": 8,
      "create_segment": 16,
      "update_segment": 16,
      "delete_segment": 16,
      "list_templates": 8,
      "get_template": 8,
      "create_template": 16,
      "update_template": 16,
      "delete_template": 16,
      "list_automations": 8,
      "get_automation": 8,
      "create_automation": 16,
      "update_automation": 16,
      "delete_automation": 16,
      "audit_audience_health": 40,
      "get_campaign_analytics": 8
    },
    "notes": "Canonical pricing aligned with PRICING_POLICY.md (standard scale 0/8/16/20/40/60)."
  }
}